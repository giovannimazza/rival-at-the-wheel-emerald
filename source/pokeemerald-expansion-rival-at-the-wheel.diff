diff --git a/src/battle_remote.c b/src/battle_remote.c
new file mode 100644
index 00000000..a8620a21
--- /dev/null
+++ b/src/battle_remote.c
@@ -0,0 +1,828 @@
+#include "global.h"
+#include "battle.h"
+#include "battle_ai_main.h"
+#include "battle_ai_util.h"
+#include "battle_controllers.h"
+#include "battle_gimmick.h"
+#include "battle_setup.h"
+#include "constants/characters.h"
+#include "battle_main.h"
+#include "battle_remote.h"
+#include "battle_terastal.h"
+#include "battle_util.h"
+#include "battle_z_move.h"
+#include "data.h"
+#include "item.h"
+#include "pokemon.h"
+#include "string_util.h"
+#include "constants/abilities.h"
+#include "constants/battle.h"
+#include "constants/battle_util.h"
+#include "constants/item_effects.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/trainers.h"
+
+// Mailbox shared with the Lua script (see rival_at_the_wheel_emerald.lua).
+EWRAM_DATA struct RemoteControl gRemoteControl = {0};
+static EWRAM_DATA u8 sRemoteWant[MAX_BATTLERS_COUNT] = {0};
+static EWRAM_DATA u8 sRemotePendingMove[MAX_BATTLERS_COUNT] = {0};
+static EWRAM_DATA u8 sRemotePendingTarget[MAX_BATTLERS_COUNT] = {0};
+static EWRAM_DATA u8 sRemotePendingGimmick[MAX_BATTLERS_COUNT] = {0};
+static EWRAM_DATA u8 sRemoteAiTurn[MAX_BATTLERS_COUNT] = {0};
+
+const u8 gRemoteControlSignature[] = "REMOTE-TRAINER-2";
+// Storing the address keeps the signature in ROM even with LTO.
+EWRAM_DATA const u8 *volatile gRemoteControlSignaturePtr = NULL;
+
+#define NO_PENDING_MOVE 0xFF
+
+static void CopyName(u8 *dest, const u8 *src, u32 maxLen)
+{
+    u32 i = 0;
+
+    if (src != NULL)
+    {
+        for (; i < maxLen - 1 && src[i] != EOS; i++)
+            dest[i] = src[i];
+    }
+    for (; i < maxLen; i++)
+        dest[i] = EOS;
+}
+
+bool32 RemoteControl_IsActive(enum BattlerId battler)
+{
+    if (!(gBattleTypeFlags & BATTLE_TYPE_TRAINER))
+        return FALSE;
+    if (gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_RECORDED | BATTLE_TYPE_RECORDED_LINK
+                          | BATTLE_TYPE_SAFARI | BATTLE_TYPE_CATCH_TUTORIAL | BATTLE_TYPE_PALACE
+                          | BATTLE_TYPE_MULTI | BATTLE_TYPE_TOWER_LINK_MULTI | BATTLE_TYPE_POKEDUDE
+                          | BATTLE_TYPE_RAID))
+        return FALSE;
+    if (IsOnPlayerSide(battler))
+        return FALSE;
+    return TRUE;
+}
+
+// Same rules the battle engine applies when the player tries to switch.
+static bool32 RemoteCanSwitch(enum BattlerId battler)
+{
+    if (gBattleTypeFlags & BATTLE_TYPE_ARENA)
+        return FALSE;
+    if (gBattleStruct->battlerState[battler].commanderSpecies != SPECIES_NONE)
+        return FALSE;
+    if (!CanBattlerEscape(battler) && GetBattlerHoldEffect(battler) != HOLD_EFFECT_SHED_SHELL)
+        return FALSE;
+    if (GetItemHoldEffect(gBattleMons[battler].item) != HOLD_EFFECT_SHED_SHELL && IsAbilityPreventingEscape(battler))
+        return FALSE;
+    return TRUE;
+}
+
+static u32 GetPartyLimit(enum BattlerId battler)
+{
+    return GetAILastPartyIndex(battler);
+}
+
+static u8 GetSwitchableMons(enum BattlerId battler)
+{
+    struct Pokemon *party = GetBattlerParty(battler);
+    enum BattlerId battlerIn1, battlerIn2;
+    u32 i, limit = GetPartyLimit(battler);
+    u8 mask = 0;
+
+    GetActiveBattlerIds(battler, &battlerIn1, &battlerIn2);
+    for (i = 0; i < limit && i < PARTY_SIZE; i++)
+    {
+        if (!IsValidForBattle(&party[i]))
+            continue;
+        if (IsPartyMonOnFieldOrChosenToSwitch(battler, i, battlerIn1, battlerIn2))
+            continue;
+        mask |= 1 << i;
+    }
+    return mask;
+}
+
+static bool32 ItemsAllowed(enum BattlerId battler)
+{
+    if (gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_FRONTIER_NO_PYRAMID | BATTLE_TYPE_EREADER_TRAINER | BATTLE_TYPE_RECORDED_LINK))
+        return FALSE;
+    if (ShouldBattleRestrictionsApply(battler) && !IsAllowedToUseBag())
+        return FALSE;
+    if (gBattleMons[battler].volatiles.semiInvulnerable == STATE_SKY_DROP_TARGET)
+        return FALSE;
+    if (gBattleMons[battler].volatiles.embargoTimer)
+        return FALSE;
+    return TRUE;
+}
+
+// Whether a trainer item would do something now. Mirrors ShouldUseItem()
+// without the AI's "is it a good idea" part.
+static bool32 CheckTrainerItem(enum BattlerId battler, u32 slot)
+{
+    enum Item item;
+    const u8 *itemEffects;
+    struct BattlePokemon *mon = &gBattleMons[battler];
+
+    if (slot >= MAX_TRAINER_ITEMS || !ItemsAllowed(battler))
+        return FALSE;
+    item = gBattleHistory->trainerItems[slot];
+    if (item == ITEM_NONE)
+        return FALSE;
+    itemEffects = GetItemEffect(item);
+    if (itemEffects == NULL || mon->hp == 0)
+        return FALSE;
+
+    switch (GetItemBattleUsage(item))
+    {
+    case EFFECT_ITEM_HEAL_AND_CURE_STATUS:
+        return mon->hp < mon->maxHP || mon->status1 != 0 || mon->volatiles.confusionTimer > 0;
+    case EFFECT_ITEM_RESTORE_HP:
+        return mon->hp < mon->maxHP;
+    case EFFECT_ITEM_CURE_STATUS:
+        return (itemEffects[3] & ITEM3_SLEEP && mon->status1 & STATUS1_SLEEP)
+            || (itemEffects[3] & ITEM3_POISON && mon->status1 & STATUS1_PSN_ANY)
+            || (itemEffects[3] & ITEM3_BURN && mon->status1 & STATUS1_BURN)
+            || (itemEffects[3] & ITEM3_FREEZE && mon->status1 & STATUS1_ICY_ANY)
+            || (itemEffects[3] & ITEM3_PARALYSIS && mon->status1 & STATUS1_PARALYSIS)
+            || (itemEffects[3] & ITEM3_CONFUSION && mon->volatiles.confusionTimer > 0);
+    case EFFECT_ITEM_INCREASE_STAT:
+    case EFFECT_ITEM_INCREASE_ALL_STATS:
+        return TRUE;
+    case EFFECT_ITEM_SET_FOCUS_ENERGY:
+        return !mon->volatiles.dragonCheer && !mon->volatiles.focusEnergy;
+    case EFFECT_ITEM_SET_MIST:
+        return !(gSideStatuses[GetBattlerSide(battler)] & SIDE_STATUS_MIST);
+    case EFFECT_ITEM_REVIVE:
+        return GetFirstFaintedPartyIndex(battler) != PARTY_SIZE;
+    case EFFECT_ITEM_USE_POKE_FLUTE:
+        return (mon->status1 & STATUS1_SLEEP) != 0;
+    default:
+        return FALSE;
+    }
+}
+
+static bool32 GimmickUsableWith(enum BattlerId battler, u32 moveSlot)
+{
+    enum Gimmick gimmick = gBattleStruct->gimmick.usableGimmick[battler];
+
+    if (gimmick == GIMMICK_NONE || HasTrainerUsedGimmick(battler, gimmick))
+        return FALSE;
+    if (gimmick == GIMMICK_Z_MOVE)
+        return moveSlot < MAX_MON_MOVES && GetUsableZMove(battler, gBattleMons[battler].moves[moveSlot]) != MOVE_NONE;
+    return TRUE;
+}
+
+static enum BattlerId FirstAliveFoe(enum BattlerId battler)
+{
+    enum BattlerId foe = GetBattlerAtPosition(B_POSITION_PLAYER_LEFT);
+
+    if (IsDoubleBattle() && !IsBattlerAlive(foe))
+        foe = GetBattlerAtPosition(B_POSITION_PLAYER_RIGHT);
+    return foe;
+}
+
+static enum BattlerId ResolveTarget(enum BattlerId battler, enum Move move, u32 requested)
+{
+    enum BattlerId partner = GetPartnerBattler(battler);
+
+    switch (GetBattlerMoveSelectionTargetType(battler, move))
+    {
+    case TARGET_ALLY:
+        return partner;
+    case TARGET_USER_OR_ALLY:
+        if (IsDoubleBattle() && requested == partner && IsBattlerAlive(partner))
+            return partner;
+        return battler;
+    case TARGET_USER:
+    case TARGET_USER_AND_ALLY:
+    case TARGET_ALL_BATTLERS:
+    case TARGET_FIELD:
+        return battler;
+    case TARGET_BOTH:
+    case TARGET_FOES_AND_ALLY:
+    case TARGET_OPPONENTS_FIELD:
+        return FirstAliveFoe(battler);
+    default:
+        if (!IsDoubleBattle())
+            return GetBattlerAtPosition(B_POSITION_PLAYER_LEFT);
+        if (requested < gBattlersCount && requested != battler && IsBattlerAlive(requested)
+         && CanTargetBattler(battler, requested, move))
+            return requested;
+        return FirstAliveFoe(battler);
+    }
+}
+
+static u32 GetVolatileFlags(enum BattlerId battler)
+{
+    struct BattlePokemon *mon = &gBattleMons[battler];
+    u32 flags = 0;
+
+    if (mon->volatiles.confusionTimer)
+        flags |= REMOTE_VOL_CONFUSED;
+    if (mon->volatiles.substitute)
+        flags |= REMOTE_VOL_SUBSTITUTE;
+    if (mon->volatiles.infatuation)
+        flags |= REMOTE_VOL_INFATUATED;
+    if (mon->volatiles.leechSeed)
+        flags |= REMOTE_VOL_LEECH_SEED;
+    if (mon->volatiles.cursed)
+        flags |= REMOTE_VOL_CURSED;
+    if (mon->volatiles.nightmare)
+        flags |= REMOTE_VOL_NIGHTMARE;
+    if (mon->volatiles.perishSong)
+        flags |= REMOTE_VOL_PERISH_SONG;
+    if (mon->volatiles.encoredMove != MOVE_NONE)
+        flags |= REMOTE_VOL_ENCORE;
+    if (mon->volatiles.torment)
+        flags |= REMOTE_VOL_TORMENT;
+    if (mon->volatiles.yawn)
+        flags |= REMOTE_VOL_YAWN;
+    if (mon->volatiles.focusEnergy || mon->volatiles.dragonCheer)
+        flags |= REMOTE_VOL_FOCUS_ENERGY;
+    if (mon->volatiles.aquaRing)
+        flags |= REMOTE_VOL_AQUA_RING;
+    if (mon->volatiles.tauntTimer)
+        flags |= REMOTE_VOL_TAUNT;
+    if (mon->volatiles.escapePrevention || mon->volatiles.wrapped || mon->volatiles.root)
+        flags |= REMOTE_VOL_TRAPPED;
+    return flags;
+}
+
+static void FillBattlerInfo(struct RemoteBattlerInfo *info, enum BattlerId battler)
+{
+    struct BattlePokemon *mon = &gBattleMons[battler];
+    u32 i;
+
+    info->species = mon->species;
+    info->hp = mon->hp;
+    info->maxHP = mon->maxHP;
+    info->item = mon->item;
+    info->ability = mon->ability;
+    info->lastMove = gLastMoves[battler];
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        info->moves[i] = mon->moves[i];
+        info->pp[i] = mon->pp[i];
+        info->maxPp[i] = CalculatePPWithBonus(mon->moves[i], mon->ppBonuses, i);
+    }
+    info->status1 = mon->status1;
+    info->volFlags = GetVolatileFlags(battler);
+    for (i = 0; i < NUM_BATTLE_STATS && i < 8; i++)
+        info->statStages[i] = mon->statStages[i];
+    for (i = 0; i < 3; i++)
+        info->types[i] = mon->types[i];
+    info->level = mon->level;
+    info->present = (gAbsentBattlerFlags & (1u << battler)) ? 0 : 1;
+    info->partyIndex = gBattlerPartyIndexes[battler];
+    info->teraType = GetBattlerTeraType(battler);
+    info->activeGimmick = GetActiveGimmick(battler);
+    CopyName(info->nickname, mon->nickname, sizeof(info->nickname));
+}
+
+static void FillTrainerNames(struct RemoteControl *rc, enum BattlerId battler)
+{
+    u16 trainerId = TRAINER_BATTLE_PARAM.opponentA;
+
+    CopyName(rc->trainerName, NULL, sizeof(rc->trainerName));
+    CopyName(rc->trainerClassName, NULL, sizeof(rc->trainerClassName));
+    if (GetBattlerPosition(battler) == B_POSITION_OPPONENT_RIGHT
+     && gBattleTypeFlags & BATTLE_TYPE_TWO_OPPONENTS && !BATTLE_TWO_VS_ONE_OPPONENT)
+        trainerId = TRAINER_BATTLE_PARAM.opponentB;
+    rc->trainerId = trainerId;
+    if (gBattleTypeFlags & (BATTLE_TYPE_FRONTIER | BATTLE_TYPE_TRAINER_HILL | BATTLE_TYPE_EREADER_TRAINER
+                          | BATTLE_TYPE_SECRET_BASE | BATTLE_TYPE_LINK))
+        return;
+    if (trainerId == TRAINER_NONE || trainerId >= TRAINERS_COUNT)
+        return;
+    CopyName(rc->trainerClassName, GetTrainerClassNameFromId(trainerId), sizeof(rc->trainerClassName));
+    CopyName(rc->trainerName, GetTrainerNameFromId(trainerId), sizeof(rc->trainerName));
+}
+
+static void FillFieldInfo(struct RemoteControl *rc)
+{
+    u32 flags = 0;
+    u32 side;
+
+    if (gBattleWeather & B_WEATHER_RAIN) flags |= REMOTE_FIELD_RAIN;
+    if (gBattleWeather & B_WEATHER_SUN) flags |= REMOTE_FIELD_SUN;
+    if (gBattleWeather & B_WEATHER_SANDSTORM) flags |= REMOTE_FIELD_SAND;
+    if (gBattleWeather & B_WEATHER_HAIL) flags |= REMOTE_FIELD_HAIL;
+    if (gBattleWeather & B_WEATHER_SNOW) flags |= REMOTE_FIELD_SNOW;
+    if (gBattleWeather & B_WEATHER_FOG) flags |= REMOTE_FIELD_FOG;
+    if (gBattleWeather & B_WEATHER_STRONG_WINDS) flags |= REMOTE_FIELD_WINDS;
+    switch (gFieldTimers.terrain)
+    {
+    case B_TERRAIN_ELECTRIC: flags |= REMOTE_FIELD_T_ELECTRIC; break;
+    case B_TERRAIN_GRASSY:   flags |= REMOTE_FIELD_T_GRASSY; break;
+    case B_TERRAIN_MISTY:    flags |= REMOTE_FIELD_T_MISTY; break;
+    case B_TERRAIN_PSYCHIC:  flags |= REMOTE_FIELD_T_PSYCHIC; break;
+    default: break;
+    }
+    if (gFieldStatuses & STATUS_FIELD_TRICK_ROOM) flags |= REMOTE_FIELD_TRICK_ROOM;
+    if (gFieldStatuses & STATUS_FIELD_GRAVITY) flags |= REMOTE_FIELD_GRAVITY;
+    if (gFieldStatuses & STATUS_FIELD_MAGIC_ROOM) flags |= REMOTE_FIELD_MAGIC_ROOM;
+    if (gFieldStatuses & STATUS_FIELD_WONDER_ROOM) flags |= REMOTE_FIELD_WONDER_ROOM;
+    rc->fieldFlags = flags;
+
+    for (side = 0; side < NUM_BATTLE_SIDES; side++)
+    {
+        u32 s = gSideStatuses[side];
+        u16 f = 0;
+        if (s & SIDE_STATUS_REFLECT) f |= REMOTE_SIDE_REFLECT;
+        if (s & SIDE_STATUS_LIGHTSCREEN) f |= REMOTE_SIDE_LIGHT_SCREEN;
+        if (s & SIDE_STATUS_AURORA_VEIL) f |= REMOTE_SIDE_AURORA_VEIL;
+        if (s & SIDE_STATUS_SAFEGUARD) f |= REMOTE_SIDE_SAFEGUARD;
+        if (s & SIDE_STATUS_MIST) f |= REMOTE_SIDE_MIST;
+        if (s & SIDE_STATUS_TAILWIND) f |= REMOTE_SIDE_TAILWIND;
+        if (IsHazardOnSide(side, HAZARDS_SPIKES)) f |= REMOTE_SIDE_SPIKES;
+        if (IsHazardOnSide(side, HAZARDS_TOXIC_SPIKES)) f |= REMOTE_SIDE_TOXIC_SPIKES;
+        if (IsHazardOnSide(side, HAZARDS_STEALTH_ROCK)) f |= REMOTE_SIDE_STEALTH_ROCK;
+        if (IsHazardOnSide(side, HAZARDS_STICKY_WEB)) f |= REMOTE_SIDE_STICKY_WEB;
+        rc->sideFlags[side] = f;
+    }
+}
+
+static void FillSnapshot(enum BattlerId battler)
+{
+    struct RemoteControl *rc = &gRemoteControl;
+    struct Pokemon *party = GetBattlerParty(battler);
+    struct Pokemon *playerParty = GetBattlerParty(GetBattlerAtPosition(B_POSITION_PLAYER_LEFT));
+    u32 i, j, limit;
+    u8 switchable;
+
+    rc->magic = REMOTE_MAGIC;
+    rc->version = REMOTE_VERSION;
+    rc->battleTypeFlags = gBattleTypeFlags;
+    rc->battlersCount = gBattlersCount;
+    rc->inBattle = TRUE;
+    rc->turn = gBattleResults.battleTurnCounter;
+    rc->absentFlags = gAbsentBattlerFlags;
+    FillTrainerNames(rc, battler);
+    FillFieldInfo(rc);
+
+    for (i = 0; i < MAX_TRAINER_ITEMS; i++)
+        rc->trainerItems[i] = gBattleHistory->trainerItems[i];
+
+    for (i = 0; i < MAX_BATTLERS_COUNT; i++)
+    {
+        if (i < gBattlersCount)
+        {
+            FillBattlerInfo(&rc->battlers[i], i);
+        }
+        else
+        {
+            rc->battlers[i].species = SPECIES_NONE;
+            rc->battlers[i].present = 0;
+        }
+    }
+
+    switchable = GetSwitchableMons(battler);
+    rc->switchableMons = switchable;
+    rc->canSwitch = RemoteCanSwitch(battler);
+    rc->unusableMoves = CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL) & 0xF;
+    rc->itemUsable = 0;
+    for (i = 0; i < MAX_TRAINER_ITEMS; i++)
+        if (CheckTrainerItem(battler, i))
+            rc->itemUsable |= 1 << i;
+    rc->usableGimmick = gBattleStruct->gimmick.usableGimmick[battler];
+    if (rc->usableGimmick != GIMMICK_NONE && HasTrainerUsedGimmick(battler, rc->usableGimmick))
+        rc->usableGimmick = GIMMICK_NONE;
+    rc->zMoveMask = 0;
+    if (rc->usableGimmick == GIMMICK_Z_MOVE)
+    {
+        for (i = 0; i < MAX_MON_MOVES; i++)
+            if (GimmickUsableWith(battler, i))
+                rc->zMoveMask |= 1 << i;
+    }
+
+    limit = GetPartyLimit(battler);
+    rc->partyCount = limit;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct RemoteMonInfo *info = &rc->party[i];
+        struct Pokemon *mon = &party[i];
+        u32 speciesOrEgg = (i < limit) ? GetMonData(mon, MON_DATA_SPECIES_OR_EGG) : SPECIES_NONE;
+        u8 ppBonuses;
+
+        info->flags = 0;
+        CopyName(info->nickname, NULL, sizeof(info->nickname));
+        if (speciesOrEgg == SPECIES_NONE)
+        {
+            info->species = SPECIES_NONE;
+            continue;
+        }
+        info->species = GetMonData(mon, MON_DATA_SPECIES);
+        info->hp = GetMonData(mon, MON_DATA_HP);
+        info->maxHP = GetMonData(mon, MON_DATA_MAX_HP);
+        info->heldItem = GetMonData(mon, MON_DATA_HELD_ITEM);
+        info->status = GetMonData(mon, MON_DATA_STATUS);
+        info->level = GetMonData(mon, MON_DATA_LEVEL);
+        info->ability = GetMonAbility(mon);
+        info->teraType = GetMonData(mon, MON_DATA_TERA_TYPE);
+        ppBonuses = GetMonData(mon, MON_DATA_PP_BONUSES);
+        for (j = 0; j < MAX_MON_MOVES; j++)
+        {
+            info->moves[j] = GetMonData(mon, MON_DATA_MOVE1 + j);
+            info->pp[j] = GetMonData(mon, MON_DATA_PP1 + j);
+            info->maxPp[j] = CalculatePPWithBonus(info->moves[j], ppBonuses, j);
+        }
+        {
+            u8 nick[POKEMON_NAME_LENGTH + 2];
+            GetMonData(mon, MON_DATA_NICKNAME, nick);
+            nick[POKEMON_NAME_LENGTH] = EOS;
+            CopyName(info->nickname, nick, sizeof(info->nickname));
+        }
+        info->flags |= 1;
+        for (j = 0; j < gBattlersCount; j++)
+        {
+            if (!IsOnPlayerSide(j) && BattlersShareParty(battler, j)
+             && gBattlerPartyIndexes[j] == i && !(gAbsentBattlerFlags & (1u << j)))
+                info->flags |= 2;
+        }
+        if (switchable & (1 << i))
+            info->flags |= 4;
+        if (speciesOrEgg == SPECIES_EGG)
+            info->flags |= 8;
+    }
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        u32 species = GetMonData(&playerParty[i], MON_DATA_SPECIES_OR_EGG);
+        if (species == SPECIES_NONE || species == SPECIES_EGG)
+            rc->playerPartyStatus[i] = 0;
+        else if (GetMonData(&playerParty[i], MON_DATA_HP) == 0)
+            rc->playerPartyStatus[i] = 3;
+        else
+            rc->playerPartyStatus[i] = GetMonData(&playerParty[i], MON_DATA_STATUS) != 0 ? 2 : 1;
+    }
+}
+
+static void PostRequest(enum BattlerId battler, u8 type)
+{
+    struct RemoteControl *rc = &gRemoteControl;
+
+    FillSnapshot(battler);
+    rc->respFlags = 0;
+    rc->reqBattler = battler;
+    rc->reqSeq++;
+    if (rc->reqSeq == rc->respSeq)
+        rc->reqSeq++;
+    rc->reqType = type;
+}
+
+void RemoteControl_InitBattler(enum BattlerId battler)
+{
+    struct RemoteControl *rc = &gRemoteControl;
+
+    if (battler < MAX_BATTLERS_COUNT)
+    {
+        sRemoteWant[battler] = REMOTE_REQ_NONE;
+        sRemotePendingMove[battler] = NO_PENDING_MOVE;
+        sRemotePendingTarget[battler] = 0;
+        sRemotePendingGimmick[battler] = FALSE;
+        sRemoteAiTurn[battler] = FALSE;
+    }
+    rc->magic = REMOTE_MAGIC;
+    rc->version = REMOTE_VERSION;
+    rc->reqType = REMOTE_REQ_NONE;
+    rc->respSeq = rc->reqSeq;
+    rc->lastError = REMOTE_ERR_NONE;
+    rc->inBattle = TRUE;
+    gRemoteControlSignaturePtr = gRemoteControlSignature;
+}
+
+void RemoteControl_EndBattle(void)
+{
+    gRemoteControl.reqType = REMOTE_REQ_NONE;
+    gRemoteControl.inBattle = FALSE;
+}
+
+void RemoteControl_BeginRequest(enum BattlerId battler, u8 type)
+{
+    if (type == REMOTE_REQ_ACTION)
+    {
+        sRemotePendingMove[battler] = NO_PENDING_MOVE;
+        sRemotePendingGimmick[battler] = FALSE;
+        sRemoteAiTurn[battler] = FALSE;
+    }
+    sRemoteWant[battler] = type;
+}
+
+bool32 RemoteControl_TakeAiTurn(enum BattlerId battler)
+{
+    if (sRemoteAiTurn[battler])
+    {
+        sRemoteAiTurn[battler] = FALSE;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void EmitChosenMove(enum BattlerId battler, u32 slot, enum BattlerId target, bool32 gimmick)
+{
+    if (gimmick)
+    {
+        gBattleStruct->gimmick.toActivate |= 1u << battler;
+        BtlController_EmitTwoReturnValues(battler, B_COMM_TO_ENGINE, B_ACTION_EXEC_SCRIPT, slot | RET_GIMMICK | (target << 8));
+    }
+    else
+    {
+        SetAIUsingGimmick(battler, NO_GIMMICK);
+        BtlController_EmitTwoReturnValues(battler, B_COMM_TO_ENGINE, B_ACTION_EXEC_SCRIPT, slot | (target << 8));
+    }
+}
+
+bool32 RemoteControl_TakePendingMove(enum BattlerId battler)
+{
+    u32 slot = sRemotePendingMove[battler];
+    u32 unusable;
+    bool32 gimmick = sRemotePendingGimmick[battler];
+
+    if (slot == NO_PENDING_MOVE)
+        return FALSE;
+    sRemotePendingMove[battler] = NO_PENDING_MOVE;
+    sRemotePendingGimmick[battler] = FALSE;
+    unusable = CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL);
+    if (slot >= MAX_MON_MOVES || (unusable & (1u << slot)))
+        return FALSE; // something changed: ask again
+    if (gimmick && !GimmickUsableWith(battler, slot))
+        gimmick = FALSE;
+    EmitChosenMove(battler, slot, sRemotePendingTarget[battler], gimmick);
+    return TRUE;
+}
+
+static u8 ApplyMove(enum BattlerId battler, u8 reqType, u32 slot, u32 requestedTarget, bool32 gimmick)
+{
+    u32 unusable = CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL) & 0xF;
+    enum BattlerId target;
+
+    if (unusable == 0xF)
+    {
+        // Every move is blocked: the engine will use Struggle.
+        if (reqType == REMOTE_REQ_ACTION)
+        {
+            SetAIUsingGimmick(battler, NO_GIMMICK);
+            BtlController_EmitTwoReturnValues(battler, B_COMM_TO_ENGINE, B_ACTION_USE_MOVE, FirstAliveFoe(battler) << 8);
+            return REMOTE_ERR_NONE;
+        }
+        slot = 0;
+        gimmick = FALSE;
+    }
+    else
+    {
+        if (slot >= MAX_MON_MOVES || gBattleMons[battler].moves[slot] == MOVE_NONE)
+            return REMOTE_ERR_BAD_MOVE;
+        if (unusable & (1u << slot))
+            return REMOTE_ERR_MOVE_BLOCKED;
+        if (gimmick && !GimmickUsableWith(battler, slot))
+            return REMOTE_ERR_BAD_GIMMICK;
+    }
+    target = ResolveTarget(battler, gBattleMons[battler].moves[slot], requestedTarget);
+    if (reqType == REMOTE_REQ_ACTION)
+    {
+        sRemotePendingMove[battler] = slot;
+        sRemotePendingTarget[battler] = target;
+        sRemotePendingGimmick[battler] = gimmick;
+        BtlController_EmitTwoReturnValues(battler, B_COMM_TO_ENGINE, B_ACTION_USE_MOVE, target << 8);
+    }
+    else
+    {
+        EmitChosenMove(battler, slot, target, gimmick);
+    }
+    return REMOTE_ERR_NONE;
+}
+
+static u8 ApplyItem(enum BattlerId battler, u32 slot)
+{
+    enum Item item;
+
+    if (!CheckTrainerItem(battler, slot))
+        return REMOTE_ERR_BAD_ITEM;
+    item = gBattleHistory->trainerItems[slot];
+    if (GetItemBattleUsage(item) == EFFECT_ITEM_REVIVE)
+        gBattleStruct->itemPartyIndex[battler] = GetFirstFaintedPartyIndex(battler);
+    else
+        gBattleStruct->itemPartyIndex[battler] = gBattlerPartyIndexes[battler];
+    SetAIUsingGimmick(battler, NO_GIMMICK);
+    BtlController_EmitTwoReturnValues(battler, B_COMM_TO_ENGINE, B_ACTION_USE_ITEM, 0);
+    gBattleStruct->chosenItem[battler] = item;
+    gBattleHistory->trainerItems[slot] = ITEM_NONE;
+    return REMOTE_ERR_NONE;
+}
+
+static u8 ApplySwitch(enum BattlerId battler, u8 reqType, u32 partyIdx)
+{
+    if (partyIdx >= PARTY_SIZE || !(GetSwitchableMons(battler) & (1 << partyIdx)))
+        return REMOTE_ERR_BAD_SWITCH;
+    if (reqType == REMOTE_REQ_ACTION)
+    {
+        if (!RemoteCanSwitch(battler))
+            return REMOTE_ERR_TRAPPED;
+        BtlController_EmitTwoReturnValues(battler, B_COMM_TO_ENGINE, B_ACTION_SWITCH, 0);
+        SetAIUsingGimmick(battler, NO_GIMMICK);
+        gBattleStruct->AI_monToSwitchIntoId[battler] = partyIdx;
+        gBattleStruct->monToSwitchIntoId[battler] = partyIdx;
+        gAiLogicData->monToSwitchInId[battler] = partyIdx;
+    }
+    else
+    {
+        gBattleStruct->monToSwitchIntoId[battler] = partyIdx;
+        BtlController_EmitChosenMonReturnValue(battler, B_COMM_TO_ENGINE, partyIdx, NULL);
+    }
+    return REMOTE_ERR_NONE;
+}
+
+u8 RemoteControl_Poll(enum BattlerId battler)
+{
+    struct RemoteControl *rc = &gRemoteControl;
+    u8 reqType, err;
+
+    if (sRemoteWant[battler] == REMOTE_REQ_NONE)
+        return REMOTE_RESULT_USE_AI;
+    if (rc->reqType == REMOTE_REQ_NONE)
+    {
+        rc->lastError = REMOTE_ERR_NONE;
+        PostRequest(battler, sRemoteWant[battler]);
+        return REMOTE_RESULT_WAIT;
+    }
+    if (rc->reqBattler != battler || rc->respSeq != rc->reqSeq)
+        return REMOTE_RESULT_WAIT;
+
+    reqType = rc->reqType;
+    err = REMOTE_ERR_BAD_TYPE;
+    switch (rc->respType)
+    {
+    case REMOTE_RESP_AI:
+        rc->reqType = REMOTE_REQ_NONE;
+        rc->lastError = REMOTE_ERR_NONE;
+        sRemoteWant[battler] = REMOTE_REQ_NONE;
+        if (reqType == REMOTE_REQ_ACTION)
+            sRemoteAiTurn[battler] = TRUE;
+        return REMOTE_RESULT_USE_AI;
+    case REMOTE_RESP_MOVE:
+        if (reqType == REMOTE_REQ_ACTION || reqType == REMOTE_REQ_MOVE)
+            err = ApplyMove(battler, reqType, rc->respArg1, rc->respArg2, (rc->respFlags & 1) != 0);
+        break;
+    case REMOTE_RESP_ITEM:
+        if (reqType == REMOTE_REQ_ACTION)
+            err = ApplyItem(battler, rc->respArg1);
+        break;
+    case REMOTE_RESP_SWITCH:
+        if (reqType == REMOTE_REQ_ACTION || reqType == REMOTE_REQ_SWITCH_IN)
+            err = ApplySwitch(battler, reqType, rc->respArg1);
+        break;
+    }
+
+    if (err != REMOTE_ERR_NONE)
+    {
+        PostRequest(battler, reqType);
+        rc->lastError = err;
+        return REMOTE_RESULT_WAIT;
+    }
+    rc->reqType = REMOTE_REQ_NONE;
+    rc->lastError = REMOTE_ERR_NONE;
+    sRemoteWant[battler] = REMOTE_REQ_NONE;
+    return REMOTE_RESULT_DONE;
+}
+
+// The Lua script reads these offsets directly: keep them in sync.
+STATIC_ASSERT(sizeof(struct RemoteBattlerInfo) == 0x40, RemoteBattlerInfoSize);
+STATIC_ASSERT(sizeof(struct RemoteMonInfo) == 0x30, RemoteMonInfoSize);
+STATIC_ASSERT(offsetof(struct RemoteBattlerInfo, status1) == 0x14, RemoteBattlerStatus);
+STATIC_ASSERT(offsetof(struct RemoteBattlerInfo, nickname) == 0x34, RemoteBattlerNick);
+STATIC_ASSERT(offsetof(struct RemoteMonInfo, nickname) == 0x20, RemoteMonNick);
+STATIC_ASSERT(offsetof(struct RemoteControl, fieldFlags) == 0x40, RemoteField);
+STATIC_ASSERT(offsetof(struct RemoteControl, version) == 0x48, RemoteVersion);
+STATIC_ASSERT(offsetof(struct RemoteControl, battlers) == 0x50, RemoteBattlers);
+STATIC_ASSERT(offsetof(struct RemoteControl, party) == 0x150, RemoteParty);
+STATIC_ASSERT(offsetof(struct RemoteControl, playerPartyStatus) == 0x270, RemotePlayerParty);
+STATIC_ASSERT(sizeof(struct RemoteControl) == 0x278, RemoteControlSize);
