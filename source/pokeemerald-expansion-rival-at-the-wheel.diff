+        *(u32 *)(base + off) = (u32)GetItemName(i);
+    hdr[9] = off;
+    for (i = 0; i < ABILITIES_COUNT; i++, off += 4)
+        *(u32 *)(base + off) = (u32)gAbilitiesInfo[i].name;
+    hdr[10] = off;
+    for (i = 0; i < NUMBER_OF_MON_TYPES; i++, off += 4)
+        *(u32 *)(base + off) = (u32)gTypesInfo[i].name;
