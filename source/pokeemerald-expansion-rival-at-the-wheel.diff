+static void OpponentWaitRemoteAction(enum BattlerId battler)
+{
+    switch (RemoteControl_Poll(battler))
+    {
+    case REMOTE_RESULT_DONE:
+        BtlController_Complete(battler);
+        break;
+    case REMOTE_RESULT_USE_AI:
+        OpponentChooseAction_AI(battler);
+        break;
+    }
+}
+
+static void OpponentWaitRemoteMove(enum BattlerId battler)
+{
+    switch (RemoteControl_Poll(battler))
+    {
+    case REMOTE_RESULT_DONE:
+        BtlController_Complete(battler);
+        break;
+    case REMOTE_RESULT_USE_AI:
+        OpponentChooseMove_AI(battler);
+        break;
+    }
+}
+
+static void OpponentWaitRemoteSwitch(enum BattlerId battler)
+{
+    switch (RemoteControl_Poll(battler))
+    {
+    case REMOTE_RESULT_DONE:
+        BtlController_Complete(battler);
+        break;
+    case REMOTE_RESULT_USE_AI:
+        OpponentChoosePokemon_AI(battler);
+        break;
+    }
+}
+
+static void OpponentHandleChooseAction(enum BattlerId battler)
+{
+    if (RemoteControl_IsActive(battler))
+    {
+        RemoteControl_BeginRequest(battler, REMOTE_REQ_ACTION);
+        gBattlerControllerFuncs[battler] = OpponentWaitRemoteAction;
+        return;
+    }
+    OpponentChooseAction_AI(battler);
+}
+
 static void OpponentHandleChooseMove(enum BattlerId battler)
+{
+    if (RemoteControl_IsActive(battler))
+    {
+        if (RemoteControl_TakeAiTurn(battler))
+        {
+            OpponentChooseMove_AI(battler);
+            return;
+        }
+        if (RemoteControl_TakePendingMove(battler))
+        {
+            BtlController_Complete(battler);
+            return;
+        }
+        RemoteControl_BeginRequest(battler, REMOTE_REQ_MOVE);
+        gBattlerControllerFuncs[battler] = OpponentWaitRemoteMove;
+        return;
+    }
+    OpponentChooseMove_AI(battler);
+}
+
+static void OpponentChooseMove_AI(enum BattlerId battler)
 {
     if (gBattleTypeFlags & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_FIRST_BATTLE | BATTLE_TYPE_SAFARI | BATTLE_TYPE_ROAMER)
      || IsWildMonSmart())
@@ -513,6 +589,19 @@ static void OpponentHandleChooseItem(enum BattlerId battler)
 }
 
 static void OpponentHandleChoosePokemon(enum BattlerId battler)
+{
+    if (RemoteControl_IsActive(battler)
+     && gBattleResources->bufferA[battler][1] != PARTY_ACTION_CHOOSE_FAINTED_MON
+     && gBattleStruct->AI_monToSwitchIntoId[battler] == PARTY_SIZE)
