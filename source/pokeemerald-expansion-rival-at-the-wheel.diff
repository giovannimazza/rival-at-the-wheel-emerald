+++ b/include/battle_remote.h
@@ -0,0 +1,170 @@
+#ifndef GUARD_BATTLE_REMOTE_H
+#define GUARD_BATTLE_REMOTE_H
+
+// Remote Trainer for pokeemerald-expansion.
+// A second person, through an mGBA Lua script, chooses what the opposing
+// trainer does. The game writes a request into gRemoteControl and waits;
+// the script writes the answer back. Layout must match the Lua script.
+
+#define REMOTE_MAGIC        0x4C544352 // "RCTL"
+#define REMOTE_VERSION      2
+
+#define REMOTE_REQ_NONE       0
+#define REMOTE_REQ_ACTION     1 // move, item, switch or AI
+#define REMOTE_REQ_MOVE       2 // move or AI only
+#define REMOTE_REQ_SWITCH_IN  3 // party slot or AI
+
+#define REMOTE_RESP_MOVE    1 // arg1 = move slot, arg2 = target battler, respFlags bit0 = use gimmick
+#define REMOTE_RESP_ITEM    2 // arg1 = trainer item slot
+#define REMOTE_RESP_SWITCH  3 // arg1 = party slot
+#define REMOTE_RESP_AI      4
+
+#define REMOTE_ERR_NONE          0
+#define REMOTE_ERR_BAD_TYPE      1
+#define REMOTE_ERR_BAD_MOVE      2
+#define REMOTE_ERR_MOVE_BLOCKED  3
+#define REMOTE_ERR_BAD_ITEM      4
+#define REMOTE_ERR_BAD_SWITCH    5
+#define REMOTE_ERR_TRAPPED       6
+#define REMOTE_ERR_BAD_GIMMICK   7
+
+#define REMOTE_RESULT_WAIT   0
+#define REMOTE_RESULT_DONE   1
+#define REMOTE_RESULT_USE_AI 2
+
+// volFlags bits
+#define REMOTE_VOL_CONFUSED     (1 << 0)
+#define REMOTE_VOL_SUBSTITUTE   (1 << 1)
+#define REMOTE_VOL_INFATUATED   (1 << 2)
+#define REMOTE_VOL_LEECH_SEED   (1 << 3)
+#define REMOTE_VOL_CURSED       (1 << 4)
+#define REMOTE_VOL_NIGHTMARE    (1 << 5)
+#define REMOTE_VOL_PERISH_SONG  (1 << 6)
+#define REMOTE_VOL_ENCORE       (1 << 7)
+#define REMOTE_VOL_TORMENT      (1 << 8)
+#define REMOTE_VOL_YAWN         (1 << 9)
+#define REMOTE_VOL_FOCUS_ENERGY (1 << 10)
+#define REMOTE_VOL_AQUA_RING    (1 << 11)
+#define REMOTE_VOL_TAUNT        (1 << 12)
+#define REMOTE_VOL_TRAPPED      (1 << 13)
+
+// fieldFlags bits
+#define REMOTE_FIELD_RAIN        (1 << 0)
+#define REMOTE_FIELD_SUN         (1 << 1)
+#define REMOTE_FIELD_SAND        (1 << 2)
+#define REMOTE_FIELD_HAIL        (1 << 3)
+#define REMOTE_FIELD_SNOW        (1 << 4)
+#define REMOTE_FIELD_FOG         (1 << 5)
+#define REMOTE_FIELD_WINDS       (1 << 6)
+#define REMOTE_FIELD_T_ELECTRIC  (1 << 7)
+#define REMOTE_FIELD_T_GRASSY    (1 << 8)
+#define REMOTE_FIELD_T_MISTY     (1 << 9)
+#define REMOTE_FIELD_T_PSYCHIC   (1 << 10)
+#define REMOTE_FIELD_TRICK_ROOM  (1 << 11)
+#define REMOTE_FIELD_GRAVITY     (1 << 12)
+#define REMOTE_FIELD_MAGIC_ROOM  (1 << 13)
+#define REMOTE_FIELD_WONDER_ROOM (1 << 14)
+
+// sideFlags bits
+#define REMOTE_SIDE_REFLECT      (1 << 0)
+#define REMOTE_SIDE_LIGHT_SCREEN (1 << 1)
+#define REMOTE_SIDE_AURORA_VEIL  (1 << 2)
+#define REMOTE_SIDE_SAFEGUARD    (1 << 3)
+#define REMOTE_SIDE_MIST         (1 << 4)
+#define REMOTE_SIDE_TAILWIND     (1 << 5)
+#define REMOTE_SIDE_SPIKES       (1 << 6)
+#define REMOTE_SIDE_TOXIC_SPIKES (1 << 7)
+#define REMOTE_SIDE_STEALTH_ROCK (1 << 8)
+#define REMOTE_SIDE_STICKY_WEB   (1 << 9)
+
+struct RemoteBattlerInfo
+{
+    /*0x00*/ u16 species;
+    /*0x02*/ u16 hp;
+    /*0x04*/ u16 maxHP;
+    /*0x06*/ u16 item;
+    /*0x08*/ u16 ability;
+    /*0x0A*/ u16 lastMove;
+    /*0x0C*/ u16 moves[4];
+    /*0x14*/ u32 status1;
+    /*0x18*/ u32 volFlags;
+    /*0x1C*/ u8 pp[4];
+    /*0x20*/ u8 maxPp[4];
+    /*0x24*/ s8 statStages[8];
+    /*0x2C*/ u8 types[3];
+    /*0x2F*/ u8 level;
+    /*0x30*/ u8 present;
+    /*0x31*/ u8 partyIndex;
+    /*0x32*/ u8 teraType;
+    /*0x33*/ u8 activeGimmick;
+    /*0x34*/ u8 nickname[12];
+}; // size 0x40
+
+struct RemoteMonInfo
+{
+    /*0x00*/ u16 species;
+    /*0x02*/ u16 hp;
+    /*0x04*/ u16 maxHP;
+    /*0x06*/ u16 heldItem;
+    /*0x08*/ u32 status;
+    /*0x0C*/ u16 moves[4];
+    /*0x14*/ u8 pp[4];
+    /*0x18*/ u8 maxPp[4];
+    /*0x1C*/ u8 level;
+    /*0x1D*/ u8 flags; // bit0 exists, bit1 on field, bit2 can be sent in, bit3 egg
+    /*0x1E*/ u16 ability;
+    /*0x20*/ u8 nickname[12];
+    /*0x2C*/ u8 teraType;
+    /*0x2D*/ u8 padding[3];
+}; // size 0x30
+
+struct RemoteControl
+{
+    /*0x000*/ u32 magic;
+    /*0x004*/ u8 reqSeq;
+    /*0x005*/ u8 reqType;
+    /*0x006*/ u8 reqBattler;
+    /*0x007*/ u8 respSeq;
+    /*0x008*/ u8 respType;
+    /*0x009*/ u8 respArg1;
+    /*0x00A*/ u8 respArg2;
+    /*0x00B*/ u8 lastError;
+    /*0x00C*/ u32 battleTypeFlags;
+    /*0x010*/ u16 trainerId;
+    /*0x012*/ u8 battlersCount;
+    /*0x013*/ u8 inBattle;
+    /*0x014*/ u16 trainerItems[4];
+    /*0x01C*/ u8 trainerClassName[14];
+    /*0x02A*/ u8 trainerName[14];
+    /*0x038*/ u8 unusableMoves;
+    /*0x039*/ u8 canSwitch;
+    /*0x03A*/ u8 itemUsable;
+    /*0x03B*/ u8 switchableMons;
+    /*0x03C*/ u8 turn;
+    /*0x03D*/ u8 absentFlags;
+    /*0x03E*/ u8 respFlags;      // written by the script
+    /*0x03F*/ u8 usableGimmick;  // enum Gimmick usable now by reqBattler (0 = none)
+    /*0x040*/ u32 fieldFlags;
+    /*0x044*/ u16 sideFlags[2];  // [0] player side, [1] opponent side
+    /*0x048*/ u32 version;
+    /*0x04C*/ u8 zMoveMask;      // moves that can become Z-Moves
+    /*0x04D*/ u8 partyCount;
+    /*0x04E*/ u8 padding[2];
+    /*0x050*/ struct RemoteBattlerInfo battlers[4];
+    /*0x150*/ struct RemoteMonInfo party[6];
+    /*0x270*/ u8 playerPartyStatus[6]; // 0 none, 1 ok, 2 status problem, 3 fainted
+    /*0x276*/ u8 padding2[2];
+}; // size 0x278
+
+extern struct RemoteControl gRemoteControl;
+extern const u8 gRemoteControlSignature[];
+
+bool32 RemoteControl_IsActive(enum BattlerId battler);
+void RemoteControl_InitBattler(enum BattlerId battler);
+void RemoteControl_EndBattle(void);
+void RemoteControl_BeginRequest(enum BattlerId battler, u8 type);
+u8 RemoteControl_Poll(enum BattlerId battler);
+bool32 RemoteControl_TakeAiTurn(enum BattlerId battler);
+bool32 RemoteControl_TakePendingMove(enum BattlerId battler);
+
+#endif // GUARD_BATTLE_REMOTE_H
