+static void TestSetMoves(struct Pokemon *mon, enum Move move)
+{
+    u32 j, hp = 999;
+
+    SetMonMoveSlot(mon, move, 0);
+    for (j = 1; j < MAX_MON_MOVES; j++)
+        SetMonMoveSlot(mon, MOVE_NONE, j);
+    SetMonData(mon, MON_DATA_MAX_HP, &hp);
+    SetMonData(mon, MON_DATA_HP, &hp);
+}
+
+void CB2_RemoteTestBoot(void)
+{
+    struct Pokemon *party = gParties[B_TRAINER_PLAYER];
+    bool32 doubles;
+
+    if (sTestFrame == 0)
+    {
+        SetSaveBlocksPointers(GetSaveBlocksPointersBaseOffset());
+        ResetMenuAndMonGlobals();
+        Save_ResetSaveCounters();
+        Sav2_ClearSetDefault();
+        RemoteTestDumpData();
+    }
+    if (sTestFrame < 30)
+    {
+        sTestFrame++;
+        return;
+    }
+    InitHeap(gHeap, HEAP_SIZE);
+    gSaveBlock2Ptr->playerName[0] = CHAR_R;
+    gSaveBlock2Ptr->playerName[1] = CHAR_E;
+    gSaveBlock2Ptr->playerName[2] = CHAR_D;
+    gSaveBlock2Ptr->playerName[3] = EOS;
+    gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+    gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_FAST;
+    gSaveBlock2Ptr->optionsBattleSceneOff = TRUE;
+
+    doubles = (sTestBattleNum++ & 1);
+    ZeroPlayerPartyMons();
+    CreateRandomMonWithIVs(&party[0], SPECIES_MEWTWO, 100, 31);
+    CreateRandomMonWithIVs(&party[1], SPECIES_PIKACHU, 100, 31);
+    TestSetMoves(&party[0], doubles ? MOVE_SURF : MOVE_SCRATCH);
+    TestSetMoves(&party[1], MOVE_SCRATCH);
+    CalculatePlayerPartyCount();
+
+    if (!doubles)
+    {
+        TRAINER_BATTLE_PARAM.opponentA = TRAINER_ROXANNE_1;
+        gBattleTypeFlags = BATTLE_TYPE_TRAINER;
+    }
+    else
+    {
+        TRAINER_BATTLE_PARAM.opponentA = TRAINER_TATE_AND_LIZA_1;
+        gBattleTypeFlags = BATTLE_TYPE_TRAINER | BATTLE_TYPE_DOUBLE;
+    }
+    CreateNPCTrainerPartyFromTrainer(&gParties[B_TRAINER_OPPONENT_A][0], GetTrainerStructFromId(TRAINER_BATTLE_PARAM.opponentA));
+    gMain.savedCallback = CB2_RemoteTestBoot;
+    SetMainCallback2(CB2_InitBattle);
+}
+#endif // REMOTE_TEST_BOOT
