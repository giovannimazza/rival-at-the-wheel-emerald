+        RemoteControl_BeginRequest(battler, REMOTE_REQ_SWITCH_IN);
+        gBattlerControllerFuncs[battler] = OpponentWaitRemoteSwitch;
+        return;
+    }
+    OpponentChoosePokemon_AI(battler);
+}
